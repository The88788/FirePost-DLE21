<article class="main-comments border-bottom pb-3 mb-4 [available=lastcomments]bg-white p-4 rounded[/available]">
<div class="each-comment">

<div class="post-header mt-0 pt-0">
<div class="media">
<div class="user-img">[profile]<img src="{foto}" width="40" alt="{login}">[/profile]</div>
<div class="media-body">
<div class="user-title">[profile]{login}[/profile]</div>
<ul class="entry-meta"><li class="meta-privacy"><i class="icofont-group"></i>{group-name}</li><li class="meta-time">{date}</li></ul>
</div></div></div>

<div class="post-body">{comment}</div>

<div class="post-footer">
<ul>
[rating]<li class="post-react comment-rating">
[rating-type-1]{rating}[/rating-type-1]
[rating-type-2][rating-plus]<i class="icofont-thumbs-up"></i> Нравится[/rating-plus] <span class="comment-score">{rating}</span>[/rating-type-2]
[rating-type-3][rating-plus]<i class="icofont-thumbs-up"></i> Нравится[/rating-plus] <span class="comment-score">{rating}</span> [rating-minus]<i class="icofont-thumbs-down"></i> Не нравится[/rating-minus][/rating-type-3]
[rating-type-4][rating-plus]<i class="icofont-thumbs-up"></i> Нравится <span class="comment-score">{likes}</span>[/rating-plus] [rating-minus]<i class="icofont-thumbs-down"></i> Не нравится <span class="comment-score">{dislikes}</span>[/rating-minus][/rating-type-4]
</li>[/rating]
<li>[fast]<i class="icofont-reply"></i>Ответить[/fast]</li>
<li>[com-edit]<i class="icofont-ui-edit"></i>Изменить[/com-edit]</li>
<li>[com-del]<i class="icofont-delete"></i>Удалить[/com-del]</li>
</ul>
</div>

</div>
</article>
