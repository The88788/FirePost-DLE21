<section class="card-body bg-white rounded mb-4"><h2 class="h4">{title}</h2><p>{question}</p><div>{list}</div>[voted]<p>Проголосовало: {votes}</p>[/voted][closed]<p>Опрос закрыт {close-date}</p>[/closed][not-voted]<button class="btn btn-primary" type="button" onclick="doPoll('vote', '{news-id}'); return false;">Голосовать</button> <button class="btn btn-light" type="button" onclick="doPoll('results', '{news-id}'); return false;">Результаты</button>[/not-voted]</section>
