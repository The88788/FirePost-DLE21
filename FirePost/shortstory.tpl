<article class="block-box firepost-card">
<div class="entry-category">{link-category}</div>
<h2 class="entry-title">[full-link]{title}[/full-link]</h2>
<ul class="entry-meta"><li><i class="icofont-user"></i> {author}</li><li><i class="icofont-calendar"></i> {date}</li></ul>
[xfgiven_poster][full-link]<img class="firepost-cover" src="[xfvalue_thumb_url_poster]" alt="[xfvalue_image_description_poster]" loading="lazy">[/full-link][/xfgiven_poster]
<div class="blog-content">{short-story}</div>
<div class="firepost-card-footer"><span><i class="icofont-eye-alt"></i> {views} &nbsp; <i class="icofont-comment"></i> {comments-num}</span>
[not-group=5]<span class="card-favorite">[add-favorites]<i class="icofont-book-mark"></i> В закладки[/add-favorites][del-favorites]<i class="icofont-book-mark"></i> Убрать из закладок[/del-favorites]</span>[/not-group]
[full-link]<span class="btn btn-primary">Читать далее</span>[/full-link]</div></article>


