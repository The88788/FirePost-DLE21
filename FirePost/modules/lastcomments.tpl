<div class="media">

<div class="item-img">
<a href="{THEME}/../../user/{login}"><img src="{foto}" width="44" alt="{login}"></a>
</div>

<div class="media-body">
<h4 class="item-title mb-1"><a href="{THEME}/../../user/{login}" class="author-name">{login}</a></h4>
<div class="activity-time mb-2"><i class="icofont-calendar"></i> {date}</div>
<div style="line-height:150%;font-size:13px">{comment limit="70"}..</div>
<a href="{news-link}"><i class="icofont-reply"></i> Ответить</a>
</div>

</div>
